# ─────────────────────────────────────────────────────────────────────────────
# Gold Butterfly — environment
#
# On InstaCloud you never edit this file: `npm run setup` stores the keys as
# platform secrets and the compute service receives them (plus DATABASE_URL)
# as runtime env. This file is for running the server locally.
# ─────────────────────────────────────────────────────────────────────────────

# ── Required ──
# Alpaca Markets — bars, option chains, trading calendar, and daily news.
# https://alpaca.markets  → Paper or Live → API keys
ALPACA_API_KEY=
ALPACA_API_SECRET=

# OpenRouter — one gateway to every LLM the strategist and agents use.
# https://openrouter.ai  → Keys
OPENROUTER_API_KEY=

# ── Optional ──
# Finnhub — market cap / P/E and upcoming earnings dates. Without it those
# dashboard cards stay on the seeded values and earnings markers are omitted.
FINNHUB_API_KEY=

# PostHog — server-side product analytics (strategy + agent events).
POSTHOG_API_KEY=
POSTHOG_HOST=https://us.i.posthog.com
# PostHog in the browser bundle (Vite reads VITE_* at build time).
VITE_PUBLIC_POSTHOG_KEY=
VITE_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# ── Local server only ──
# Postgres connection string. Against your InstaCloud database:
#   DATABASE_URL="$(insta db url)" npm run dev:server
DATABASE_URL=
PORT=8080
# SCHEDULER=off runs the API without cron (a deployed instance is already
# feeding the same database).
SCHEDULER=on
# Agents processed in parallel by the daily trading tick.
AGENT_CONCURRENCY=3
